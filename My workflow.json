    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst body = $json.body?.message;\n\nif (!body) return [];\n\nconst pubSubId = body.message_id || body.messageId;\n\n// Drop duplicate Pub/Sub pings instantly\nif (staticData.lastPubSubId === pubSubId) {\n  return []; \n}\nstaticData.lastPubSubId = pubSubId;\n\nlet decodedData = {};\nif (body.data) {\n  try {\n    const jsonString = Buffer.from(body.data, 'base64').toString('utf-8');\n    decodedData = JSON.parse(jsonString);\n  } catch (err) {\n    decodedData = { raw: body.data };\n  }\n}\n\nreturn [{\n  json: {\n    pubSubMessageId: pubSubId,\n    emailAddress: decodedData.emailAddress,\n    historyId: decodedData.historyId,\n    publishTime: body.publishTime || body.publish_time\n  }\n}];"
      },
